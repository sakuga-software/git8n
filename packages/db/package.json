{
  "name": "@git8n/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./messages": "./src/messages.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "build": "esbuild src/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  }
}
