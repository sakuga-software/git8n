{
  "name": "i18n-editor",
  "url": "https://github.com/sakuga-software/i18n-editor",
  "description": "Reads the locale files of a repository and commits the translations that a reviewer publishes.",
  "public": true,
  "hook_attributes": {
    "url": "https://example.invalid/no-webhook",
    "active": false
  },
  "redirect_url": "https://example.invalid/after-creation",
  "callback_urls": ["https://i18n.sakuga.dev/api/auth/callback/github"],
  "request_oauth_on_install": false,
  "setup_url": "https://i18n.sakuga.dev/setup",
  "setup_on_update": true,
  "default_permissions": {
    "contents": "write",
    "metadata": "read"
  },
  "default_events": []
}
